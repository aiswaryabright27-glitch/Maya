{
  "name": "maya-voice-layer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test:js": "node --test tests-js/*.test.cjs",
    "test:backend": "node scripts/test-backend.cjs",
    "test": "npm run test:js && npm run test:backend",
    "build": "npm run typecheck && vite build",
    "package": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "vite": "6.1.0"
  },
  "devDependencies": {
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "electron": "35.0.0",
    "electron-builder": "26.0.12",
    "eslint": "10.14.0",
    "globals": "15.14.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.1",
    "wait-on": "8.0.2"
  },
  "build": {
    "appId": "com.maya.voice",
    "productName": "Maya",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "!backend/.venv/**",
      "!**/.env",
      "!**/.env.*"
    ],
    "asarUnpack": ["backend/**/*"],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis"
    }
  }
}
